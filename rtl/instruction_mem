module instruction_mem (
    input  wire [31:0] addr,
    output wire [31:0] instr
);
    reg [31:0] rom [0:63];

    // Word-aligned indexing: divide byte address by 4 (addr[7:2])
    assign instr = rom[addr[7:2]];

    initial begin
        rom[0] = 32'h20010005; // addi $1, $0, 5
        rom[1] = 32'h2002000A; // addi $2, $0, 10
        rom[2] = 32'h00221820; // add  $3, $1, $2
        rom[3] = 32'h10600001; // beq  $3, $0, 1
        rom[4] = 32'h00622022; // sub  $4, $3, $2
        rom[5] = 32'h08000005; // j    5
    end
endmodule
